---
import type { MenuItem } from '../types';

// ナビゲーションメニュー項目
const menuItems: MenuItem[] = [
  { label: 'ホーム', href: '/' },
  { label: '業務内容', href: '/services' },
  {
    label: '畳について',
    href: '/knowledge',
    children: [
      { label: '畳を選ぶポイント', href: '/knowledge/selection' },
      { label: '畳替えのタイミング', href: '/knowledge/timing' }
    ]
  },
  { label: '施工例', href: '/works' },
  { label: '会社概要・アクセス', href: '/about' },
  { label: 'お問い合わせ', href: '/contact' }
];

const currentPath = Astro.url.pathname;

// 現在のパスとメニュー項目のパスが一致するかチェック
function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<nav class="nav" aria-label="メインナビゲーション">
  <ul class="nav__list">
    {menuItems.map((item) => (
      <li class:list={['nav__item', { 'nav__item--has-children': item.children }]}>
        <a
          href={item.href}
          class:list={['nav__link', { 'nav__link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>

        {item.children && (
          <ul class="nav__submenu">
            {item.children.map((child) => (
              <li class="nav__submenu-item">
                <a
                  href={child.href}
                  class:list={['nav__submenu-link', { 'nav__submenu-link--active': isActive(child.href) }]}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: block;
    padding: var(--spacing-md);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--transition-base);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__link:hover {
    background-color: var(--color-background-light);
    text-decoration: none;
  }

  .nav__link--active {
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
  }

  .nav__submenu {
    list-style: none;
    padding: 0;
    margin: 0;
    background-color: var(--color-background-light);
  }

  .nav__submenu-item {
    border-bottom: 1px solid var(--color-border);
  }

  .nav__submenu-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md) var(--spacing-sm) var(--spacing-xl);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: background-color var(--transition-base);
  }

  .nav__submenu-link:hover {
    background-color: var(--color-white);
    text-decoration: none;
  }

  .nav__submenu-link--active {
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
  }

  /* デスクトップレイアウト */
  @media (min-width: 1024px) {
    .nav__list {
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .nav__item {
      position: relative;
    }

    .nav__link {
      padding: var(--spacing-sm) var(--spacing-md);
      border-bottom: none;
      border-radius: var(--radius-sm);
    }

    .nav__item--has-children:hover .nav__submenu {
      display: block;
    }

    .nav__submenu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 200px;
      background-color: var(--color-white);
      box-shadow: var(--shadow-lg);
      border-radius: var(--radius-sm);
      z-index: var(--z-dropdown);
      margin-top: var(--spacing-xs);
    }

    .nav__submenu-item {
      border-bottom: 1px solid var(--color-border);
    }

    .nav__submenu-item:last-child {
      border-bottom: none;
    }

    .nav__submenu-link {
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--font-size-md);
    }
  }
</style>
